#!/bin/sh

PRG=`basename "$0"`
DIR=`dirname "$0"`/..
PYTHON=${PYTHON:-python3}

# ANTLR 3 runtime lives in antlr/, the generated lexer/parser in parser/
PYPATH="$DIR/src:$DIR/antlr:$DIR/parser/src/scribble:$DIR/parser"

usage() {
  echo scribblec:
  cat <<EOF
  -h --help                                     display this information
  -V                                            echo the python command
  -ip [path]                                    Scribble import path
  -pp [path]                                    Payload type path
  -project [full global protocol name] [role]   project local protocols
  -deadlock                                     check the local types for deadlock
EOF
}

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  -V)
    echo "PYTHONPATH='$PYPATH' $PYTHON -m scribble.main" "$@"
    exit 0
    ;;
esac

PYTHONPATH="$PYPATH" exec "$PYTHON" -m scribble.main "$@"
