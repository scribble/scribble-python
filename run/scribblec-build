#!/bin/sh

# Regenerate the Scribble lexer/parser from src/scribble/Scribble.g.
# Requires a Java runtime (JRE 8 or later) to run the bundled ANTLR 3.5.3 tool.

DIR=`dirname "$0"`/..
cd "$DIR" || exit 1

PARSERDIR=parser
JAR=antlr/antlr-3.5.3-complete.jar

if [ ! -d "$PARSERDIR" ]; then
	mkdir "$PARSERDIR"
fi

java -cp "$JAR" org.antlr.Tool -o "$PARSERDIR" src/scribble/Scribble.g
