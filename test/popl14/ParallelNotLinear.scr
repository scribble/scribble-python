/**
 * Well-formedness fixture for Section 4.6.8 -- parallel linearity.
 *
 * Both branches of the parallel block let A send m1() to B, so the potential
 * operators of A in the two branches are not disjoint and the interleaving of
 * the branches is not determined: A's sends are racing, and B can be left
 * waiting for a message whose partner branch has already terminated.
 *
 *$ bin/scribblec test/demo/popl14/ParallelNotLinear.scr
 */

module popl14.ParallelNotLinear;


global protocol ParallelNotLinear(role A, role B, role C) {
	par {
		m1() from A to B;
		m2() from B to C;
	} and {
		m1() from A to B;
		m4() from B to C;
	}
}
