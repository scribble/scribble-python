module popl14.ResourceControl_RC_User;



type <py>  "types.IntType" from "types.py" as int;

local protocol RC_User at User(role User as U, role Controller as C, role Agent as A) {
req(int) to C;
interruptible __1
{
rec X
{
interruptible __2
{
rec Y
{
data() from A;
continue Y;
}
}
with {
throws pause() to A;
}
resume() to A;
continue X;
}
}
with {
throws stop() to A, C;
catches timeout() from C;
}
}
