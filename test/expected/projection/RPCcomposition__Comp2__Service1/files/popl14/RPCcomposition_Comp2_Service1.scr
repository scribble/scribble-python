module popl14.RPCcomposition_Comp2_Service1;

import popl14.RPCcomposition_Relay_Middle;


local protocol Comp2_Service1 at Service1(role Client as C, role Service1 as S1, role Service2 as S2, role Service3 as S3, role Service4 as S4) {
do __1: popl14.RPCcomposition_Relay_Middle.Relay_Middle<m1(), m2()>(C as First, S1 as Middle, S2 as Last);
do __2: popl14.RPCcomposition_Relay_Middle.Relay_Middle<m2a(), m3()>(S2 as First, S1 as Middle, S3 as Last);
do __5: popl14.RPCcomposition_Relay_Middle.Relay_Middle<m3a(), m1a()>(S2 as First, S1 as Middle, C as Last);
}
