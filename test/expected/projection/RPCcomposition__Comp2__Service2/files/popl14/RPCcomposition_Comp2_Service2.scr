module popl14.RPCcomposition_Comp2_Service2;

import popl14.RPCcomposition_Relay_Last;
import popl14.RPCcomposition_Relay_First;


local protocol Comp2_Service2 at Service2(role Client as C, role Service1 as S1, role Service2 as S2, role Service3 as S3, role Service4 as S4) {
do __1: popl14.RPCcomposition_Relay_Last.Relay_Last<m1(), m2()>(C as First, S1 as Middle, S2 as Last);
do __2: popl14.RPCcomposition_Relay_First.Relay_First<m2a(), m3()>(S2 as First, S1 as Middle, S3 as Last);
do __5: popl14.RPCcomposition_Relay_First.Relay_First<m3a(), m1a()>(S2 as First, S1 as Middle, C as Last);
}
