module popl14.RPCcomposition_Comp2_Client;

import popl14.RPCcomposition_Relay_First;
import popl14.RPCcomposition_Relay_Last;


local protocol Comp2_Client at Client(role Client as C, role Service1 as S1, role Service2 as S2, role Service3 as S3, role Service4 as S4) {
do __1: popl14.RPCcomposition_Relay_First.Relay_First<m1(), m2()>(C as First, S1 as Middle, S2 as Last);
do __5: popl14.RPCcomposition_Relay_Last.Relay_Last<m3a(), m1a()>(S2 as First, S1 as Middle, C as Last);
}
