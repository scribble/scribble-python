module popl14.ResourceControl_RC_Controller;



type <py>  "types.IntType" from "types.py" as int;

local protocol RC_Controller at Controller(role User as U, role Controller as C, role Agent as A) {
req(int) from U;
start() to A;
interruptible __1
{

}
with {
throws timeout() to A, U;
catches stop() from U;
}
}
